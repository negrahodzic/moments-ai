# ImmersiMoments Environment Configuration
# Copy this file to .env and add your API keys

# Claude API Key (Required for AI-powered parameter extraction)
# Get your key from: https://console.anthropic.com/
VITE_CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs API Key (For voice narration and audio tours)
# Get your key from: https://elevenlabs.io/
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Runware API Key (For image and video generation)
# Get your key from: https://runware.ai/
VITE_RUNWARE_API_KEY=your_runware_api_key_here

# Memories AI API Key (For semantic media analysis)
# Get your key from: https://memories.ai/
VITE_MEMORIES_API_KEY=your_memories_api_key_here 